{
    "name": "public-service-sso-keycloakify",
    "version": "0.0.0",
    "description": "Accessible, production-grade Keycloakify React theme for public service and enterprise identity platforms",
    "repository": {
        "type": "git",
        "url": "https://github.com/safwatch/public-service-sso-keycloakify.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build && node scripts/patch-ftl.js",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write",
        "emails:check": "email check ./src/email/templates",
        "emails:preview": "email preview ./src/email/templates"
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "@ant-design/icons": "5.x",
        "antd": "^5.26.6",
        "keycloakify": "^11.8.51",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@storybook/react": "^8.1.10",
        "@storybook/react-vite": "^8.1.10",
        "@types/node": "^22.9.1",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "esbuild": "^0.24.0",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "jsx-email": "^2.5.3",
        "keycloakify-emails": "workspace:*",
        "less": "^4.4.0",
        "prettier": "3.3.1",
        "storybook": "^8.1.10",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.0.8"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
